<mvc:View controllerName="project1.controller.V2Model"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Table id="v2ProductsTable" items="{v2>/Products}" mode="MultiSelect">
        <headerToolbar>
            <OverflowToolbar>
                <Title text="{i18n>productsTableTitle}" />
                <ToolbarSpacer />
                <Input placeholder="{i18n>v2ProductSearchPlaceholder}"
                    liveChange=".onProductNameFilter" width="12rem" />
                <ComboBox id="v2SortComboBox" placeholder="{i18n>v2SortComboBoxPlaceholder}"
                    items="{sort>/columns}" selectionChange=".onSortColumnChange">
                    <core:Item key="{sort>key}" text="{sort>text}" />
                </ComboBox>
                <Button text="{i18n>v2AddRecordButton}" press=".onAddRecord"
                    icon="sap-icon://add" />
                <Button text="{i18n>v2DeleteRecordButton}" press=".onDeleteRecord"
                    icon="sap-icon://delete" />
            </OverflowToolbar>
        </headerToolbar>
        <columns>
            <Column>
                <Text text="{i18n>idColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>nameColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>descriptionColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>releaseDateColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>discontinuedDateColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>ratingColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>priceColumn}" />
            </Column>
            <Column>
                <Text text="{i18n>v2EditColumn}" />
            </Column>
        </columns>
        <items>
            <ColumnListItem>
                <cells>
                    <Text text="{v2>ID}" />
                    <Text text="{v2>Name}" />
                    <Text text="{v2>Description}" />
                    <Text
                        text="{path: 'v2>ReleaseDate', type: 'sap.ui.model.type.Date', formatOptions: {style: 'medium'}}" />
                    <Text
                        text="{path: 'v2>DiscontinuedDate', type: 'sap.ui.model.type.Date', formatOptions: {style: 'medium'}}" />
                    <RatingIndicator value="{v2>Rating}" editable="false" />
                    <ObjectNumber number="{v2>Price}" />
                    <Button text="{i18n>v2EditButton}" press=".onEditRecord" />
                </cells>
            </ColumnListItem>
        </items>
    </Table>
</mvc:View>