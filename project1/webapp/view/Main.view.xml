<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m">
    <Page id="page" title="{i18n>title}">
        <IconTabBar id="modelTabBar" expandable="false">
            <items>
                <IconTabFilter key="json" text="{i18n>jsonModelTab}">
                    <mvc:XMLView viewName="project1.view.JSON" />
                </IconTabFilter>
                <IconTabFilter key="v2" text="{i18n>oDataV2ModelTab}">
                    <mvc:XMLView viewName="project1.view.V2Model" />
                </IconTabFilter>
                <IconTabFilter key="v4" text="{i18n>oDataV4ModelTab}">
                    <mvc:XMLView viewName="project1.view.V4Model" />
                </IconTabFilter>
            </items>
        </IconTabBar>
    </Page>
</mvc:View>