<Dialog id="v2ProductDialog" xmlns:m="sap.m" xmlns="sap.m" xmlns:core="sap.ui.core"
  title="{= ${productDialog>/editMode} ? ${i18n>v2ProductDialogEditTitle} : ${i18n>v2ProductDialogAddTitle} }"
  afterClose=".onProductDialogAfterClose">
  <Input value="{productDialog>/Name}"
    valueState="{productDialog>/NameState}"
    valueStateText="{i18n>v2ProductDialogRequiredField}"
    placeholder="{i18n>v2ProductDialogNamePlaceholder}"
    liveChange=".onProductDialogFieldChange" />
  <TextArea value="{productDialog>/Description}"
    valueState="{productDialog>/DescriptionState}"
    valueStateText="{i18n>v2ProductDialogRequiredField}"
    placeholder="{i18n>v2ProductDialogDescriptionPlaceholder}"
    liveChange=".onProductDialogFieldChange" />
  <Input value="{productDialog>/ReleaseDate}"
    valueState="{productDialog>/ReleaseDateState}"
    valueStateText="{i18n>v2ProductDialogRequiredField}"
    placeholder="{i18n>v2ProductDialogReleaseDatePlaceholder}"
    type="Date" liveChange=".onProductDialogFieldChange" />
  <Input value="{productDialog>/DiscontinuedDate}"
    valueState="{productDialog>/DiscontinuedDateState}"
    valueStateText="{i18n>v2ProductDialogRequiredField}"
    placeholder="{i18n>v2ProductDialogDiscontinuedDatePlaceholder}" type="Date"
    liveChange=".onProductDialogFieldChange" />
  <RatingIndicator value="{productDialog>/Rating}" maxValue="5" editable="true"
    change=".onProductDialogFieldChange" />
  <ObjectStatus text="{i18n>v2ProductDialogRequiredField}" state="Error"
    visible="{= ${productDialog>/RatingState} === 'Error' }" />
  <Input value="{productDialog>/Price}"
    valueState="{productDialog>/PriceState}"
    valueStateText="{i18n>v2ProductDialogRequiredField}"
    placeholder="{i18n>v2ProductDialogPricePlaceholder}" type="Number"
    liveChange=".onProductDialogFieldChange" />
  <beginButton>
    <Button text="{i18n>v2ProductDialogSaveButton}" press=".onSaveRecord" />
  </beginButton>
  <endButton>
    <Button text="{i18n>v2ProductDialogCancelButton}" press=".onProductDialogClose" />
  </endButton>
</Dialog>